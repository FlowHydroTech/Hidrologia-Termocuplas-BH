<mxfile host="65bd71144e">
    <diagram id="cap4-simplificado" name="Cap. 4 — Diagrama Simplificado">
        <mxGraphModel dx="789" dy="694" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1000" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="c4_title" value="&lt;b&gt;Pipeline de Procesamiento - Proyecto Termocuplas MLP&amp;nbsp;&lt;/b&gt;&lt;br&gt;Estimación de flujo vertical río–acuífero mediante señal térmica&lt;br&gt;&lt;font color=&quot;#666&quot;&gt;Río Cuncumén | Dic 2025 – Feb 2026 | 5 estaciones termocuplas&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontColor=#1a1a2e;fontFamily=Arial;" parent="1" vertex="1">
                    <mxGeometry x="150" y="20" width="800" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="c4_e1" value="&lt;b&gt;1. Adquisición de Datos&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;15 sensores de temperatura iButton instalados en 5 estaciones (TC1–TC5), cada una con 3 profundidades bajo el lecho del río.&lt;br&gt;&lt;br&gt;&lt;i&gt;Registro cada 30 minutos&lt;br&gt;21-Dic-2025 a 25-Feb-2026&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;align=center;verticalAlign=top;spacingTop=5;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="100" y="110" width="260" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="c4_a12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#333;" parent="1" source="c4_e1" target="c4_e2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c4_a12_lbl" value="Archivos CSV" style="edgeLabel;html=1;fontSize=9;fontColor=#666;" parent="c4_a12" vertex="1" connectable="0">
                    <mxGeometry x="-0.1" relative="1" as="geometry">
                        <mxPoint x="-26" as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="c4_e2" value="&lt;b&gt;2. Preparación de Datos&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;Carga automática de los archivos de cada sensor. Sincronización temporal, control de calidad y limpieza de valores anómalos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=11;align=center;verticalAlign=top;spacingTop=5;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="440" y="110" width="260" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="c4_a23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#333;" parent="1" source="c4_e2" target="c4_e3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c4_a23_lbl" value="Series alineadas" style="edgeLabel;html=1;fontSize=9;fontColor=#666;" parent="c4_a23" vertex="1" connectable="0">
                    <mxGeometry x="-0.1" relative="1" as="geometry">
                        <mxPoint x="-30" y="40" as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="c4_e3" value="&lt;b&gt;3. Análisis de la Señal Térmica&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;Ajuste de una curva sinusoidal diaria a cada sensor para extraer la &lt;b&gt;amplitud&lt;/b&gt; (variación diaria) y la &lt;b&gt;fase&lt;/b&gt; (hora del máximo) de la temperatura." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=11;align=center;verticalAlign=top;spacingTop=5;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="780" y="110" width="260" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="c4_a34" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0;entryDx=0;entryDy=0;" parent="1" source="c4_e3" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="910" y="360"/>
                        </Array>
                        <mxPoint x="910" y="280" as="sourcePoint"/>
                        <mxPoint x="750" y="360" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="c4_a34_lbl" value="Amplitud y fase" style="edgeLabel;html=1;fontSize=9;fontColor=#666;" parent="c4_a34" vertex="1" connectable="0">
                    <mxGeometry x="-0.2" relative="1" as="geometry">
                        <mxPoint x="14" y="-20" as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="c4_e4" value="&lt;b&gt;4. Cálculo del Flujo Vertical&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;Se incorporan las &lt;b&gt;propiedades térmicas del sedimento&lt;/b&gt; medidas en laboratorio (IDIEM) y se resuelve la ecuación de transporte de calor (Hatch et al., 2006).&lt;br&gt;&lt;br&gt;Método principal: &lt;b&gt;Hatch-Amplitude&lt;/b&gt;&lt;br&gt;Validación: &lt;b&gt;McCallum et al.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=11;align=center;verticalAlign=top;spacingTop=5;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="440" y="340" width="310" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="c4_a45" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#333;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="c4_e4" target="c4_e5" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="230" y="425"/>
                            <mxPoint x="230" y="570"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="c4_a45_lbl" value="Flujo estimado" style="edgeLabel;html=1;fontSize=9;fontColor=#666;" parent="c4_a45" vertex="1" connectable="0">
                    <mxGeometry x="-0.1" relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c4_idiem" value="&lt;b&gt;Laboratorio IDIEM&lt;/b&gt;&lt;br&gt;Conductividad térmica&lt;br&gt;Capacidad calórica&lt;br&gt;Dispersividad (d50)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1;fontSize=10;dashed=1;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="810" y="385" width="180" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="c4_idiem_arrow" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=1;strokeColor=#b85450;dashed=1;" parent="1" source="c4_idiem" target="c4_e4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c4_e5" value="&lt;b&gt;5. Resultados&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;Flujo promedio: &lt;b&gt;mm/día ↓&lt;/b&gt;&lt;br&gt;(Clasifiación río → acuífero)&lt;br&gt;&lt;br&gt;Rango mm/día según TC&lt;br&gt;&lt;br&gt;Incluye: índice de confiabilidad,&lt;br&gt;incertidumbre y validación cruzada&lt;br&gt;con software MATLAB VFLUX2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#388e3c;strokeWidth=2;fontSize=11;align=center;verticalAlign=top;spacingTop=5;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="100" y="580" width="260" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="c4_a56" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#333;" parent="1" source="c4_e5" target="c4_e6" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c4_e6" value="&lt;b&gt;6. Productos de Salida&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;b&gt;Tablas Excel&lt;/b&gt; (Reporte)&lt;br&gt;&lt;b&gt;Gráficos&lt;/b&gt;: series T°, barras flujo, boxplot, series temporales&lt;br&gt;&lt;b&gt;Mapas interactivos&lt;/b&gt; con estadísticas&lt;br&gt;&lt;b&gt;Archivos CSV&lt;/b&gt; para análisis posterior&lt;br&gt;&lt;br&gt;&lt;i&gt;Registro reproducible en notebook Jupyter (05A)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#3f51b5;strokeWidth=2;fontSize=11;align=center;verticalAlign=top;spacingTop=5;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="440" y="580" width="310" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="c4_footer" value="&lt;i&gt;Metodología basada en VFLUX2 (Gordon et al., 2012) — Método Hatch (2006) Eq. 6a + McCallum (2012)&lt;br&gt;Propiedades térmicas: Laboratorio IDIEM, U. de Chile | Proyecto Río Cuncumén 2025-2026&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#999;fontFamily=Arial;" parent="1" vertex="1">
                    <mxGeometry x="200" y="800" width="700" height="40" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>