<mxfile host="65bd71144e">
    <diagram id="cap4-simplificado" name="Cap. 4 — Diagrama Simplificado">
        <mxGraphModel dx="750" dy="515" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1000" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="c4_title" value="&lt;b&gt;Diagrama de Procesamiento — Capítulo 4&lt;/b&gt;&lt;br&gt;Estimación de flujo vertical río–acuífero mediante señal térmica&lt;br&gt;&lt;font color=&quot;#666&quot;&gt;Río Cuncumén | Dic 2025 – Feb 2026 | 5 estaciones termocuplas&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontColor=#1a1a2e;fontFamily=Arial;" parent="1" vertex="1">
                    <mxGeometry x="150" y="20" width="800" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="c4_e1" value="&lt;b&gt;1. Adquisición de Datos&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;15 sensores de temperatura iButton instalados en 5 estaciones (TC1–TC5), cada una con 3 profundidades bajo el lecho del río.&lt;br&gt;&lt;br&gt;&lt;i&gt;Registro cada 30 minutos&lt;br&gt;21-Dic-2025 a 25-Feb-2026&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;align=center;verticalAlign=top;spacingTop=5;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="100" y="110" width="260" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="c4_a12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#333;" parent="1" source="c4_e1" target="c4_e2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c4_a12_lbl" value="Archivos CSV" style="edgeLabel;html=1;fontSize=9;fontColor=#666;" parent="c4_a12" vertex="1" connectable="0">
                    <mxGeometry x="-0.1" relative="1" as="geometry">
                        <mxPoint x="-26" as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="c4_e2" value="&lt;b&gt;2. Preparación de Datos&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;Carga automática de los archivos de cada sensor. Sincronización temporal, control de calidad y limpieza de valores anómalos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=11;align=center;verticalAlign=top;spacingTop=5;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="440" y="110" width="260" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="c4_a23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#333;" parent="1" source="c4_e2" target="c4_e3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c4_a23_lbl" value="Series alineadas" style="edgeLabel;html=1;fontSize=9;fontColor=#666;" parent="c4_a23" vertex="1" connectable="0">
                    <mxGeometry x="-0.1" relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c4_e3" value="&lt;b&gt;3. Análisis de la Señal Térmica&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;Ajuste de una curva sinusoidal diaria a cada sensor para extraer la &lt;b&gt;amplitud&lt;/b&gt; (variación diaria) y la &lt;b&gt;fase&lt;/b&gt; (hora del máximo) de la temperatura." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=11;align=center;verticalAlign=top;spacingTop=5;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="780" y="110" width="260" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="c4_a34" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0;entryDx=0;entryDy=0;" parent="1" source="c4_e3" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="910" y="360"/>
                        </Array>
                        <mxPoint x="910" y="280" as="sourcePoint"/>
                        <mxPoint x="750" y="360" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="c4_a34_lbl" value="Amplitud y fase" style="edgeLabel;html=1;fontSize=9;fontColor=#666;" parent="c4_a34" vertex="1" connectable="0">
                    <mxGeometry x="-0.2" relative="1" as="geometry">
                        <mxPoint x="14" y="-20" as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="c4_e4" value="&lt;b&gt;4. Cálculo del Flujo Vertical&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;Se incorporan las &lt;b&gt;propiedades térmicas del sedimento&lt;/b&gt; medidas en laboratorio (IDIEM) y se resuelve la ecuación de transporte de calor (Hatch et al., 2006).&lt;br&gt;&lt;br&gt;Método principal: &lt;b&gt;Hatch-Amplitude&lt;/b&gt;&lt;br&gt;Validación: &lt;b&gt;McCallum et al.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=11;align=center;verticalAlign=top;spacingTop=5;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="440" y="340" width="310" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="c4_a45" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#333;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="c4_e4" target="c4_e5" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="230" y="425"/>
                            <mxPoint x="230" y="570"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="c4_a45_lbl" value="Flujo estimado" style="edgeLabel;html=1;fontSize=9;fontColor=#666;" parent="c4_a45" vertex="1" connectable="0">
                    <mxGeometry x="-0.1" relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c4_idiem" value="&lt;b&gt;Laboratorio IDIEM&lt;/b&gt;&lt;br&gt;Conductividad térmica&lt;br&gt;Capacidad calórica&lt;br&gt;Dispersividad (d50)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1;fontSize=10;dashed=1;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="810" y="385" width="180" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="c4_idiem_arrow" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=1;strokeColor=#b85450;dashed=1;" parent="1" source="c4_idiem" target="c4_e4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c4_e5" value="&lt;b&gt;5. Resultados&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;Flujo promedio: &lt;b&gt;443 mm/día ↓&lt;/b&gt;&lt;br&gt;(infiltración río → acuífero)&lt;br&gt;&lt;br&gt;Rango: 220 – 678 mm/día según estación&lt;br&gt;&lt;br&gt;Incluye: índice de confiabilidad,&lt;br&gt;incertidumbre y validación cruzada&lt;br&gt;con software MATLAB VFLUX2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#388e3c;strokeWidth=2;fontSize=11;align=center;verticalAlign=top;spacingTop=5;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="100" y="580" width="260" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="c4_a56" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#333;" parent="1" source="c4_e5" target="c4_e6" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c4_e6" value="&lt;b&gt;6. Productos de Salida&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;b&gt;Tablas Excel&lt;/b&gt; (7 hojas temáticas)&lt;br&gt;&lt;b&gt;Gráficos&lt;/b&gt;: series T°, barras flujo, boxplot, series temporales&lt;br&gt;&lt;b&gt;Mapas interactivos&lt;/b&gt; con estadísticas por estación&lt;br&gt;&lt;b&gt;Archivos CSV&lt;/b&gt; para análisis posterior&lt;br&gt;&lt;br&gt;&lt;i&gt;Registro reproducible en notebook Jupyter (05A)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#3f51b5;strokeWidth=2;fontSize=11;align=center;verticalAlign=top;spacingTop=5;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="440" y="580" width="310" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="c4_footer" value="&lt;i&gt;Metodología basada en VFLUX2 (Gordon et al., 2012) — Método Hatch (2006) Eq. 6a + McCallum (2012)&lt;br&gt;Propiedades térmicas: Laboratorio IDIEM, U. de Chile | Proyecto Río Silala 2025-2026&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#999;fontFamily=Arial;" parent="1" vertex="1">
                    <mxGeometry x="200" y="800" width="700" height="40" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="vflux2-pipeline" name="Pipeline VFLUX2 Python">
        <mxGraphModel dx="750" dy="515" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1200" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p1" value="&lt;b&gt;Pipeline de Procesamiento — Método VFLUX2&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontColor=#1a1a2e;fontFamily=Arial;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="200" y="15" width="1100" height="35" as="geometry"/>
                </mxCell>
                <mxCell id="p2" value="Estimación de flujo vertical río–acuífero mediante señal térmica&lt;br&gt;Río Cuncumén / Silala  |  Dic 2025 – Feb 2026  |  5 estaciones termocuplas&lt;br&gt;&lt;font color=&quot;#388E3C&quot;&gt;Actualizado 25-Mar-2026&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#546E7A;fontFamily=Arial;" parent="1" vertex="1">
                    <mxGeometry x="200" y="50" width="1100" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="p3" value="&lt;b&gt;FASE 1  —  ADQUISICIÓN Y PARÁMETROS DE ENTRADA&lt;/b&gt;" style="swimlane;startSize=40;horizontal=1;fillColor=#E3F2FD;strokeColor=#B0BEC5;strokeWidth=1;rounded=1;arcSize=6;fontSize=14;fontColor=#1565C0;fontStyle=1;fontFamily=Arial;html=1;whiteSpace=wrap;collapsible=0;swimlaneLine=0;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="40" y="80" width="1420" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="p4" value="&lt;b&gt;1. Instrumentación&lt;/b&gt;&lt;hr size=&#39;1&#39;&gt;15 sensores iButton (DS1922L / DS1923)&lt;br&gt;5 estaciones termocupla (TC1–TC5)&lt;br&gt;3 profundidades por estación" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;align=center;verticalAlign=middle;shadow=1;fontFamily=Arial;" parent="p3" vertex="1">
                    <mxGeometry x="30" y="55" width="270" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="p5" value="&lt;b&gt;2. Registro de Campo&lt;/b&gt;&lt;hr size=&#39;1&#39;&gt;Frecuencia: cada 30 minutos&lt;br&gt;Periodo: 21-Dic-2025 a 25-Feb-2026&lt;br&gt;Formato: archivos CSV por sensor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;align=center;verticalAlign=middle;shadow=1;fontFamily=Arial;" parent="p3" vertex="1">
                    <mxGeometry x="380" y="55" width="270" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="p6" value="&lt;b&gt;3. Parámetros Térmicos&lt;/b&gt;&lt;hr size=&#39;1&#39;&gt;Conductividad λ (IDIEM)&lt;br&gt;Capacidad calórica Cs (IDIEM)&lt;br&gt;Dispersividad β (d50 granulométrico)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=11;align=center;verticalAlign=middle;shadow=1;fontFamily=Arial;" parent="p3" vertex="1">
                    <mxGeometry x="730" y="55" width="270" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="p7" value="&lt;b&gt;Laboratorio IDIEM&lt;/b&gt;&lt;br&gt;U. de Chile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF;strokeColor=#b85450;strokeWidth=1;fontSize=10;align=center;verticalAlign=middle;shadow=0;fontFamily=Arial;fontStyle=2;" parent="p3" vertex="1">
                    <mxGeometry x="1030" y="65" width="150" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="p8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#37474F;targetPerimeterSpacing=6;sourcePerimeterSpacing=6;" parent="p3" source="p4" target="p5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p8_lbl" value="CSV brutos" style="edgeLabel;html=1;fontSize=9;fontColor=#78909C;fontFamily=Arial;align=center;" parent="p8" vertex="1" connectable="0">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#37474F;targetPerimeterSpacing=6;sourcePerimeterSpacing=6;dashed=1;dashPattern=8 4;" parent="p3" source="p7" target="p6" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p10" value="&lt;b&gt;FASE 2  —  PROCESAMIENTO Y CÁLCULO&lt;/b&gt;" style="swimlane;startSize=40;horizontal=1;fillColor=#E8F5E9;strokeColor=#B0BEC5;strokeWidth=1;rounded=1;arcSize=6;fontSize=14;fontColor=#2E7D32;fontStyle=1;fontFamily=Arial;html=1;whiteSpace=wrap;collapsible=0;swimlaneLine=0;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="40" y="290" width="1420" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="p11" value="&lt;b&gt;4. Preprocesamiento&lt;/b&gt;&lt;hr size=&#39;1&#39;&gt;Alineación temporal (30 min)&lt;br&gt;Control de calidad&lt;br&gt;Remoción de artefactos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=11;align=center;verticalAlign=middle;shadow=1;fontFamily=Arial;" parent="p10" vertex="1">
                    <mxGeometry x="30" y="55" width="270" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="p12" value="&lt;b&gt;5. Análisis Armónico&lt;/b&gt;&lt;hr size=&#39;1&#39;&gt;Ajuste sinusoidal (P = 24 h)&lt;br&gt;Extracción: amplitud, fase, R²&lt;br&gt;15 pares de sensores" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=11;align=center;verticalAlign=middle;shadow=1;fontFamily=Arial;" parent="p10" vertex="1">
                    <mxGeometry x="360" y="55" width="270" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="p13" value="&lt;b&gt;6. Estimación de Flujo&lt;/b&gt;&lt;hr size=&#39;1&#39;&gt;Método Hatch-Amplitude (Eq. 6a)&lt;br&gt;Validación: McCallum et al.&lt;br&gt;Incluye dispersividad térmica" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=11;align=center;verticalAlign=middle;shadow=1;fontFamily=Arial;" parent="p10" vertex="1">
                    <mxGeometry x="690" y="55" width="270" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="p14" value="&lt;b&gt;7. Series Temporales&lt;/b&gt;&lt;hr size=&#39;1&#39;&gt;Ventana deslizante 48 h / paso 12 h&lt;br&gt;Flujo estimado cada 12 h&lt;br&gt;15 pares × 5 estaciones" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=2;fontSize=11;align=center;verticalAlign=middle;shadow=1;fontFamily=Arial;" parent="p10" vertex="1">
                    <mxGeometry x="1020" y="55" width="270" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="p15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#37474F;targetPerimeterSpacing=6;sourcePerimeterSpacing=6;" parent="p10" source="p11" target="p12" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p15_lbl" value="Series alineadas" style="edgeLabel;html=1;fontSize=9;fontColor=#78909C;fontFamily=Arial;align=center;" parent="p15" vertex="1" connectable="0">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#37474F;targetPerimeterSpacing=6;sourcePerimeterSpacing=6;" parent="p10" source="p12" target="p13" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p16_lbl" value="Amplitud y fase" style="edgeLabel;html=1;fontSize=9;fontColor=#78909C;fontFamily=Arial;align=center;" parent="p16" vertex="1" connectable="0">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#37474F;targetPerimeterSpacing=6;sourcePerimeterSpacing=6;" parent="p10" source="p13" target="p14" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p17_lbl" value="Flujos por par" style="edgeLabel;html=1;fontSize=9;fontColor=#78909C;fontFamily=Arial;align=center;" parent="p17" vertex="1" connectable="0">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#37474F;targetPerimeterSpacing=6;sourcePerimeterSpacing=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p5" target="p11" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#37474F;targetPerimeterSpacing=6;sourcePerimeterSpacing=6;dashed=1;dashPattern=8 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p6" target="p13" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p19_lbl" value="Parámetros térmicos" style="edgeLabel;html=1;fontSize=9;fontColor=#78909C;fontFamily=Arial;align=center;" parent="p19" vertex="1" connectable="0">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p20" value="&lt;b&gt;FASE 3  —  ANÁLISIS ESTADÍSTICO Y VALIDACIÓN&lt;/b&gt;" style="swimlane;startSize=40;horizontal=1;fillColor=#FFF8E1;strokeColor=#B0BEC5;strokeWidth=1;rounded=1;arcSize=6;fontSize=14;fontColor=#F57F17;fontStyle=1;fontFamily=Arial;html=1;whiteSpace=wrap;collapsible=0;swimlaneLine=0;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="40" y="530" width="1420" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="p21" value="&lt;b&gt;8. Métricas de Calidad&lt;/b&gt;&lt;hr size=&#39;1&#39;&gt;Índice de Confiabilidad (IC)&lt;br&gt;Propagación de incertidumbre&lt;br&gt;Tabla IQR por estación" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=11;align=center;verticalAlign=middle;shadow=1;fontFamily=Arial;" parent="p20" vertex="1">
                    <mxGeometry x="30" y="55" width="270" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="p22" value="&lt;b&gt;9. Filtro Estadístico (MAD)&lt;/b&gt;&lt;hr size=&#39;1&#39;&gt;Desviación Absoluta Mediana (2.5σ)&lt;br&gt;Suavizado mediana móvil (w = 5)&lt;br&gt;Tendencia central por estación" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0288D1;strokeWidth=2;fontSize=11;align=center;verticalAlign=middle;shadow=1;fontFamily=Arial;" parent="p20" vertex="1">
                    <mxGeometry x="380" y="55" width="270" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="p23" value="&lt;b&gt;10. Validación Cruzada&lt;/b&gt;&lt;hr size=&#39;1&#39;&gt;Comparación Python vs MATLAB VFLUX2&lt;br&gt;Δ%: ±2% (TC2) a ±20% (TC1,TC5)&lt;br&gt;Incertidumbre promedio: ±17.3%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=11;align=center;verticalAlign=middle;shadow=1;fontFamily=Arial;" parent="p20" vertex="1">
                    <mxGeometry x="730" y="55" width="270" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="p24" value="&lt;b&gt;Resultado: 443 mm/día ↓&lt;/b&gt; (infiltración río → acuífero)&lt;br&gt;Rango: 220 – 678 mm/día según estación" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=1;fontSize=10;align=center;verticalAlign=middle;shadow=0;fontFamily=Arial;fontSize=11;fontStyle=0;" parent="p20" vertex="1">
                    <mxGeometry x="1080" y="65" width="200" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="p25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#37474F;targetPerimeterSpacing=6;sourcePerimeterSpacing=6;" parent="p20" source="p21" target="p22" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#37474F;targetPerimeterSpacing=6;sourcePerimeterSpacing=6;" parent="p20" source="p22" target="p23" edge="1">
